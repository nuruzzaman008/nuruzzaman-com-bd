{
  "name": "@nuruzzaman/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/api.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated/api.ts && npm run bundle",
    "lint": "redocly lint openapi.yaml --config redocly.yaml",
    "bundle": "redocly bundle openapi.yaml --config redocly.yaml -o openapi.json"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.1",
    "openapi-typescript": "^7.9.1",
    "yaml": "^2.7.0"
  }
}