# Generated TypeScript client. Regenerated by `npm run contracts:types`, which
# `npm run build` runs first, so it never needs to be committed.
#
# packages/contracts/openapi.json is NOT ignored: it is the bundled spec the
# Laravel contract test reads, and PHP has no YAML parser in this project.
packages/contracts/src/generated/

