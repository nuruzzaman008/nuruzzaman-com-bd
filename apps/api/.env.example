###############################################################################
# Laravel API (apps/api)
# Copy to .env and fill in. Never commit a filled-in file.
###############################################################################

APP_NAME="nuruzzaman.com.bd"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nuruzzaman
DB_USERNAME=nuruzzaman
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

# --- Session / cache / queue --------------------------------------------------
# Redis is preferred. If the production host has no Redis, set all three to the
# database/file drivers below and run `php artisan queue:table` equivalents are
# already migrated (jobs, job_batches, failed_jobs, cache, sessions).
# Must match NEXT_PUBLIC_SESSION_COOKIE in the web app: the Next.js proxy
# reads this cookie by name to decide whether a visitor is signed in.
SESSION_COOKIE=nuruzzaman_session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Fallback when the host has no Redis:
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database

# --- First-party auth ---------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,nuruzzaman.com.bd
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@nuruzzaman.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage -----------------------------------------------------------
FILESYSTEM_DISK=local
NB_PRIVATE_DISK=private
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_ACCESS_KEY_ID=
PRIVATE_S3_SECRET_ACCESS_KEY=
PRIVATE_S3_PATH_STYLE=true

# --- Owner-supplied site values (see docs/CONFIGURATION_CHECKLIST_BN.md) ------
NB_SITE_NAME="Engr. Md. Nuruzzaman, RSE"
NB_SITE_URL=https://nuruzzaman.com.bd
NB_SUPPORT_EMAIL=
NB_SUPPORT_HOURS=
NB_PHONE=
NB_BUSINESS_ADDRESS=
NB_LEGAL_ENTITY=

# Staff account created by AdminUserSeeder. The password has no default on
# purpose: outside local/testing the seeder refuses to create the account
# without one, so no deployment inherits a password that is public in the repo.
NB_ADMIN_EMAIL=admin@nuruzzaman.com.bd
NB_ADMIN_NAME="Engr. Md. Nuruzzaman"
NB_ADMIN_PASSWORD=
NB_LEGAL_REVIEWED=false
NB_LEGAL_REVIEWER=
# Only the releases actually runtime-tested, e.g. "AutoCAD 2024, 2025".
NB_TESTED_AUTOCAD_VERSIONS=
# What the build is designed for. Defaults to the sentence in the owner's own
# product document; see docs/CONFIGURATION_CHECKLIST_BN.md before changing it.
NB_DESIGNED_FOR=
NB_INSTALLER_SHA256=
NB_CODE_SIGNING_STATUS=unknown
NB_TAX_PERCENT=
NB_TAX_NOTE=
NB_REFUND_POLICY_SUMMARY=
NB_RISK_ORDER_POLICY=manual_hold
NB_COURSE_ACCESS_DAYS=
NB_GA4_ID=
NB_SEARCH_CONSOLE_VERIFICATION=

# --- Payment (server-side only, never NEXT_PUBLIC_) ---------------------------
SSLCOMMERZ_DRIVER=fake
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_SANDBOX_STORE_ID=
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
SSLCOMMERZ_LIVE_STORE_ID=
SSLCOMMERZ_LIVE_STORE_PASSWORD=
SSLCOMMERZ_IPN_ALLOWLIST=

# --- Video --------------------------------------------------------------------
VIDEO_DRIVER=none
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
VIMEO_ACCESS_TOKEN=

# --- Next.js cache revalidation webhook ---------------------------------------
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_SECRET=
