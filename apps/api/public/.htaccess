# Security headers for everything served from this host, including uploaded
# files, which LiteSpeed serves directly without passing through Laravel.
#
# The deployment never overwrites this file on the server (it can hold host
# settings), so a change here has to be copied there by hand as well.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Two years, as the website itself sends. Without it a browser that reaches
    # this host first would try plain HTTP once before being redirected, and
    # that one request can carry the session cookie.
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    # A document type that can carry script is never allowed to run one here.
    <FilesMatch "\.(svg|svgz|html?|xhtml|xml)$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
