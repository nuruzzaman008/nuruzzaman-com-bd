###############################################################################
# Root environment for docker compose.
#
# Per-service configuration lives in apps/api/.env and apps/web/.env.local.
# Copy this file to .env before running `docker compose up`.
###############################################################################

# Port the whole stack is published on locally.
HTTP_PORT=8080

# Public origin the browser sees. In production this is https://nuruzzaman.com.bd.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# MySQL credentials, also referenced by apps/api/.env.
DB_DATABASE=nuruzzaman
DB_USERNAME=nuruzzaman
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Shared secret for the signed revalidation webhook. Must match
# NEXT_REVALIDATE_SECRET in apps/api/.env.
NEXT_REVALIDATE_SECRET=
