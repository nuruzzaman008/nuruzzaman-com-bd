# Normalise line endings so a Windows checkout does not show every file as
# modified. Text files are LF in the repository and native in the working copy.
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.ico   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.woff  binary
*.woff2 binary
