# Server-only configuration. Never put database credentials here.
NB_API_ROOT="$HOME/api.nuruzzaman.com.bd"
NB_WEB_ROOT="$HOME/nuruzzaman-web"
NB_PUBLIC_SITE_URL="https://nuruzzaman.com.bd"
NB_INTERNAL_API_URL="https://api.nuruzzaman.com.bd/api/v1"
NB_API_PROXY="https://api.nuruzzaman.com.bd"
NB_MEDIA_HOST="api.nuruzzaman.com.bd"
NB_DEPLOY_API=1
NB_DEPLOY_WEB=1
NB_BUILD_WEB=1
# Deliberately opt-in: review pending migrations and verify a DB backup first.
NB_RUN_MIGRATIONS=0
# NB_MIGRATIONS_REVIEWED_COMMIT="full git commit SHA"
# NB_DATABASE_BACKUP="$HOME/private-backups/verified-database.sql"
# Use actual paths verified on your server. PHP must be >=8.4.1.
# NB_PHP_BIN="/opt/cpanel/ea-php84/root/usr/bin/php"
# NB_COMPOSER_PHAR="$HOME/composer.phar"
# NB_NODE_BIN="$HOME/nodevenv/nuruzzaman-web/22/bin/node"
# NB_NPM_BIN="$HOME/nodevenv/nuruzzaman-web/22/bin/npm"
# Off-host build: Linux with matching architecture/libc/Node and production URLs.
# NB_BUILD_WEB=0
# NB_WEB_BUILD_ROOT="$HOME/uploaded-build"
